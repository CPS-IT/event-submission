# Event Submission plugin configuration
plugin.tx_eventsubmission_app {
    view {
        templateRootPaths {
            0 = EXT:event_submission/Resources/Private/Templates/
            200 = EXT:event_submission/Resources/Private/Templates/
        }
        layoutRootPaths {
            0 = EXT:event_submission/Resources/Private/Layouts/
            200 = EXT:event_submission/Resources/Private/Layouts/
        }
        partialRootPaths {
            0 = EXT:event_submission/Resources/Private/Partials/
            200 = EXT:event_submission/Resources/Private/Partials/
        }
    }
    
    settings {
        appPid = {$eventSubmission.appPid}
        storageListPid = {$eventSubmission.storagePageUid}
    }
}
